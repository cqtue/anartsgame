<UserControl x:Class="anartsgame.views.NewGameSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:anartsgame.viewmodels"
             xmlns:services="clr-namespace:anartsgame.services"
             Background="#0a0a0a">
    <UserControl.DataContext>
        <vm:NewGameSetupViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NewGame_Title]}"
                   FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                   FontSize="36"
                   Foreground="#00ff00"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,0"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" Width="500" Margin="0,40,0,20">

                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NewGame_StartingResources]}"
                           FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                           FontSize="20"
                           Foreground="#00ff00"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <StackPanel Margin="0,0,0,15">
                    <Grid>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Resource_Metal]}"
                                   FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                                   Foreground="#4A90E2"
                                   FontSize="18"
                                   HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding MetalAmount}"
                                   Foreground="#4A90E2"
                                   FontSize="14"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="1000" Value="{Binding MetalAmount}"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            Margin="0,5,0,0"/>
                </StackPanel>


                <StackPanel Margin="0,0,0,15">
                    <Grid>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Resource_Organic]}"
                                   FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                                   Foreground="#50C878"
                                   FontSize="18"
                                   HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding OrganicAmount}"
                                   Foreground="#50C878"
                                   FontSize="14"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="1000" Value="{Binding OrganicAmount}"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <Grid>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Resource_Meat]}"
                                   FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                                   Foreground="#E74C3C"
                                   FontSize="18"
                                   HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding MeatAmount}"
                                   Foreground="#E74C3C"
                                   FontSize="14"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="1000" Value="{Binding MeatAmount}"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <Grid>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Resource_Wood]}"
                                   Foreground="#8B4513"
                                   FontSize="18"
                                   FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                                   HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding WoodAmount}"
                                   Foreground="#8B4513"
                                   FontSize="14"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="1000" Value="{Binding WoodAmount}"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            Margin="0,5,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NewGame_GameSettings]}"
                           FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                           FontSize="20"
                           Foreground="#00ff00"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,20"/>

                <CheckBox IsChecked="{Binding DisableSaving}"
                          Foreground="#E0E0E0"
                          FontSize="18"
                          Margin="0,0,0,15">
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NewGame_DisableSaving]}" Foreground="#E0E0E0" FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"/>
                </CheckBox>
                <CheckBox IsChecked="{Binding EnableConsole}"
                          Foreground="#E0E0E0"
                          FontSize="18"
                          >
                    <TextBlock Text="{Binding [NewGame_EnableConsole], Source={x:Static services:LocalizationService.Instance}}" Foreground="#E0E0E0" FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc" Height="20" Width="143"/>
                </CheckBox>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,40">
            <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NewGame_Start]}"
                    Command="{Binding StartGameCommand}"
                    Style="{StaticResource MenuButtonStyle}"
                    Width="250"/>
        </StackPanel>
    </Grid>
</UserControl>
