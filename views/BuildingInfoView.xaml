<UserControl x:Class="anartsgame.views.BuildingInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DesignHeight="600">
    <StackPanel Margin="0,10,0,0">
        <TextBlock x:Name="DescriptionText"
                   Foreground="#C8C8C8"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <TextBlock x:Name="LevelText"
                   Foreground="#C8C8C8"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   Visibility="Visible"/>

        <StackPanel x:Name="BatchProductionActivePanel" Visibility="Visible">
            <TextBlock x:Name="BatchProducingLabel"
                       Foreground="#64C8FF"
                       FontSize="14"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,10"/>
            <TextBlock x:Name="BatchRemainingText"
                       Foreground="#C8C8C8"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <ProgressBar x:Name="BatchProgressBar"
                         Height="15"
                         Background="#282828"
                         Foreground="#64C8FF"
                         Maximum="100"
                         Margin="0,0,0,20"/>
            <Button x:Name="BatchCancelButton"
                    Width="200"
                    Height="45"
                    Margin="0,0,0,10"
                    Style="{StaticResource GameButtonStyle}"
                    Click="BatchCancelButton_Click"/>
            <TextBlock x:Name="BatchCancelWarning"
                       Foreground="#FF9664"
                       FontSize="11"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
        </StackPanel>

        <StackPanel x:Name="BatchProductionSetupPanel" Visibility="Visible">
            <TextBlock x:Name="BatchAmountLabel"
                       Foreground="#C8C8C8"
                       FontSize="14"
                       Margin="0,10,0,5"/>
            <TextBlock x:Name="BatchAmountText"
                       Foreground="#969696"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <Slider x:Name="BatchAmountSlider"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Margin="0,0,0,5"
                    ValueChanged="BatchAmountSlider_ValueChanged"/>
            <TextBlock x:Name="BatchInputLabel"
                       Foreground="#B4B4B4"
                       FontSize="12"
                       Margin="0,0,0,5"/>
            <TextBlock x:Name="BatchInputText"
                       Foreground="#969696"
                       FontSize="11"
                       Margin="0,0,0,10"/>
            <Button x:Name="BatchStartButton"
                    Width="200"
                    Height="45"
                    Margin="0,10,0,20"
                    Style="{StaticResource GameButtonStyle}"
                    Click="BatchStartButton_Click"/>
        </StackPanel>

        <StackPanel x:Name="ButtonsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"
                    Visibility="Visible">
            <StackPanel x:Name="UpgradeContainer" Margin="0,0,10,0" Visibility="Visible">
                <Button x:Name="UpgradeButton"
                        Width="120"
                        Height="45"
                        FontSize="11"
                        Style="{StaticResource GameButtonStyle}"
                        Click="UpgradeButton_Click"/>
            </StackPanel>
            <Button x:Name="DeleteButton"
                    Width="120"
                    Height="45"
                    Style="{StaticResource GameButtonStyle}"
                    Click="DeleteButton_Click"/>
        </StackPanel>
        <TextBlock x:Name="UpgradeCostText"
                           Foreground="#B4B4B4"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Width="250"
                           TextAlignment="Center"
                           />

        <TextBlock x:Name="ProductionLabel"
                   Foreground="#969696"
                   FontSize="12"
                   Margin="0,10,0,10"
                   Visibility="Visible"/>

        <StackPanel x:Name="ProductionBarsPanel"/>

        <StackPanel x:Name="InvestmentPanel" Visibility="Visible">
            <TextBlock x:Name="InvestmentLabel"
                       Foreground="#969696"
                       FontSize="12"
                       Margin="0,10,0,10"/>

            <StackPanel x:Name="InvestmentActivePanel" Visibility="Visible">
                <TextBlock x:Name="InvestmentActiveText"
                           Foreground="#B4B4B4"
                           FontSize="11"
                           Margin="0,0,0,5"/>
                <ProgressBar x:Name="InvestmentProgressBar"
                             Height="8"
                             Background="#282828"
                             Foreground="#C8B432"
                             Maximum="100"
                             Margin="0,0,0,5"/>
                <TextBlock x:Name="InvestmentTimeText"
                           Foreground="#969696"
                           FontSize="10"/>
            </StackPanel>

            <TextBlock x:Name="InvestmentCooldownText"
                       Foreground="#B46464"
                       FontSize="11"
                       Visibility="Visible"/>

            <StackPanel x:Name="InvestmentButtonsPanel" Margin="0,5,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
