<UserControl x:Class="anartsgame.views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:anartsgame.viewmodels"
             xmlns:views="clr-namespace:anartsgame.views"
             xmlns:services="clr-namespace:anartsgame.services"
             xmlns:converters="clr-namespace:anartsgame.converters"
             Background="#0a0a0a">
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <Style x:Key="GameComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="pack://application:,,,/styles/Watc2.TTF#Watc"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#00ff00"/>
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="BorderBrush" Value="#00ff00"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                Name="ToggleButton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Margin="10,5"/>
                                                <TextBlock Grid.Column="1"
                                                         Text="▼"
                                                         Foreground="#00ff00"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         FontSize="10"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter
                                Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="10,5"/>

                            <Popup
                                Name="Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Slide">
                                <Grid
                                    Name="DropDown"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border
                                        Name="DropDownBorder"
                                        Background="#1a1a1a"
                                        BorderBrush="#00ff00"
                                        BorderThickness="2"/>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#00ff00"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/styles/Watc2.TTF#Watc"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            Name="Border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2a2a2a"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3a3a3a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Animated background layer -->
        <views:AnimatedBackgroundControl/>

        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings_Title]}"
                   FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                   FontSize="36"
                   Foreground="#00ff00"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,0"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="500">

            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings_Language]}"
                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                       FontSize="16"
                       Foreground="#00ff00"
                       Margin="0,0,0,10"/>
            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                      SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}"
                      IsEnabled="{Binding IsGameActive, Converter={StaticResource InverseBooleanConverter}}"
                      Style="{StaticResource GameComboBoxStyle}"
                      ItemContainerStyle="{StaticResource GameComboBoxItemStyle}"
                      Margin="0,0,0,30"/>
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings_MasterVolume]}"
                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                       FontSize="16"
                       Foreground="#00ff00"
                       Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Value="{Binding MasterVolume, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Foreground="#00ff00"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding MasterVolume, StringFormat={}{0:0}%}"
                           FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                           FontSize="16"
                           Foreground="#00ff00"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings_SoundVolume]}"
                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                       FontSize="16"
                       Foreground="#00ff00"
                       Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Value="{Binding SoundVolume, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Foreground="#00ff00"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SoundVolume, StringFormat={}{0:0}%}"
                           FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                           FontSize="16"
                           Foreground="#00ff00"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings_MusicVolume]}"
                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                       FontSize="16"
                       Foreground="#00ff00"
                       Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Value="{Binding MusicVolume, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Foreground="#00ff00"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding MusicVolume, StringFormat={}{0:0}%}"
                           FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                           FontSize="16"
                           Foreground="#00ff00"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings_Fullscreen]}"
                      IsChecked="{Binding IsFullscreen, Mode=TwoWay}"
                      FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                      FontSize="16"
                      Foreground="#00ff00"
                      Margin="0,0,0,20">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20"
                                                BorderBrush="#00ff00"
                                                BorderThickness="2"
                                                Background="Transparent"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="X"
                                                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                                                       FontSize="14"
                                                       Foreground="#00ff00"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Border>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings_Vsync]}"
                      IsChecked="{Binding IsVsyncEnabled, Mode=TwoWay}"
                      FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                      FontSize="16"
                      Foreground="#00ff00">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20"
                                                BorderBrush="#00ff00"
                                                BorderThickness="2"
                                                Background="Transparent"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="X"
                                                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                                                       FontSize="14"
                                                       Foreground="#00ff00"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Border>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,40">
            <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings_Save]}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MenuButtonStyle}"
                    Width="200"
                    Margin="0,0,20,0"/>
            <Button Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Settings_Back]}"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource MenuButtonStyle}"
                    Width="200"/>
        </StackPanel>
    </Grid>
</UserControl>
