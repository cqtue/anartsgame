<UserControl x:Class="anartsgame.views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:anartsgame.viewmodels"
             Background="#0a0a0a">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="налаштування"
                   FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                   FontSize="36"
                   Foreground="#00ff00"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,0"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="500">

            <TextBlock Text="загальна гучність"
                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                       FontSize="16"
                       Foreground="#00ff00"
                       Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Value="{Binding MasterVolume, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Foreground="#00ff00"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding MasterVolume, StringFormat={}{0:0}%}"
                           FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                           FontSize="16"
                           Foreground="#00ff00"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="гучність звуків"
                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                       FontSize="16"
                       Foreground="#00ff00"
                       Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Value="{Binding SoundVolume, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Foreground="#00ff00"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SoundVolume, StringFormat={}{0:0}%}"
                           FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                           FontSize="16"
                           Foreground="#00ff00"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="гучність музики"
                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                       FontSize="16"
                       Foreground="#00ff00"
                       Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Value="{Binding MusicVolume, Mode=TwoWay}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Foreground="#00ff00"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding MusicVolume, StringFormat={}{0:0}%}"
                           FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                           FontSize="16"
                           Foreground="#00ff00"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <CheckBox Content="повноекранний режим"
                      IsChecked="{Binding IsFullscreen, Mode=TwoWay}"
                      FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                      FontSize="16"
                      Foreground="#00ff00"
                      Margin="0,0,0,20">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20"
                                                BorderBrush="#00ff00"
                                                BorderThickness="2"
                                                Background="Transparent"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="X"
                                                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                                                       FontSize="14"
                                                       Foreground="#00ff00"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Border>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <CheckBox Content="вертикальна синхронізація"
                      IsChecked="{Binding IsVsyncEnabled, Mode=TwoWay}"
                      FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                      FontSize="16"
                      Foreground="#00ff00">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20"
                                                BorderBrush="#00ff00"
                                                BorderThickness="2"
                                                Background="Transparent"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="X"
                                                       FontFamily="pack://application:,,,/styles/Watc2.TTF#Watc"
                                                       FontSize="14"
                                                       Foreground="#00ff00"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Border>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,40">
            <Button Content="зберегти"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MenuButtonStyle}"
                    Width="200"
                    Margin="0,0,20,0"/>
            <Button Content="назад"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource MenuButtonStyle}"
                    Width="200"/>
        </StackPanel>
    </Grid>
</UserControl>
