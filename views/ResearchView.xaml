<UserControl x:Class="anartsgame.views.ResearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,10,0,0">
            <StackPanel x:Name="CurrentResearchPanel" Margin="0,0,0,20" Visibility="Collapsed">
                <TextBlock x:Name="CurrentResearchName"
                           Foreground="#64C8FF"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <ProgressBar x:Name="CurrentResearchProgress"
                             Height="12"
                             Background="#282828"
                             Foreground="#64C8FF"
                             Maximum="100"
                             Margin="0,0,0,5"/>
                <TextBlock x:Name="CurrentResearchTime"
                           Foreground="#969696"
                           FontSize="11"/>
            </StackPanel>

            <TextBlock x:Name="AvailableLabel"
                       Foreground="#969696"
                       FontSize="12"
                       Margin="0,0,0,10"/>

            <StackPanel x:Name="ResearchListPanel"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
