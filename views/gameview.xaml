<UserControl x:Class="anartsgame.views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0a0a0a"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary Source="/styles/fonts.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ViewportGrid" ClipToBounds="True">
            <Canvas x:Name="MapCanvas" Background="#0a0a0a"/>
        </Grid>

        <Grid x:Name="TopPanel" Height="60" VerticalAlignment="Top">
            <Grid.Background>
                <SolidColorBrush Color="#1a1a1a" Opacity="0.5"/>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="■" Foreground="#4A90E2" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MetalText" Text=" 0" Style="{StaticResource ResourceTextStyle}" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="●" Foreground="#50C878" FontSize="16" VerticalAlignment="Center" RenderTransformOrigin="0.479,0.606" Height="24"/>
                    <TextBlock x:Name="OrganicText" Text=" 0" Style="{StaticResource ResourceTextStyle}" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="▲" Foreground="#E74C3C" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MeatText" Text=" 0" Style="{StaticResource ResourceTextStyle}" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="◆" Foreground="#8B4513" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WoodText" Text=" 0" Style="{StaticResource ResourceTextStyle}" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="♦" Foreground="#2C2C2C" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CoalText" Text=" 0" Style="{StaticResource ResourceTextStyle}" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="TimerText" Grid.Column="1" Text="00:00" Style="{StaticResource TimerTextStyle}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="⬢" Foreground="#E0E0E0" FontSize="16" VerticalAlignment="Center" Height="24"/>
                    <TextBlock x:Name="UnitsText" Text=" 0" Style="{StaticResource ResourceTextStyle}" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="▣" Foreground="#E0E0E0" FontSize="16" VerticalAlignment="Center" Height="24"/>
                    <TextBlock x:Name="BuildingsText" Text=" 0" Style="{StaticResource ResourceTextStyle}" Margin="5,0,0,0"/>
                </StackPanel>
                <Button x:Name="SpeedButton" Content="▶" Style="{StaticResource GameButtonStyle}" Width="68" Height="40" Click="SpeedButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="BottomPanel" Height="80" VerticalAlignment="Bottom">
            <Grid.Background>
                <SolidColorBrush Color="#1a1a1a" Opacity="0.5"/>
            </Grid.Background>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BuildButton" Content="🏗" Style="{StaticResource GameButtonStyle}" Width="70" Height="60" Margin="10" Click="BuildButton_Click" FontSize="24"/>
                <Button x:Name="ResearchButton" Content="🔬" Style="{StaticResource GameButtonStyle}" Width="70" Height="60" Margin="10" Click="ResearchButton_Click" FontSize="24"/>
                <Button x:Name="TradeButton" Content="💱" Style="{StaticResource GameButtonStyle}" Width="70" Height="60" Margin="10" Click="TradeButton_Click" FontSize="24"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="RightPanel" Width="300" HorizontalAlignment="Right" Background="#1a1a1a" Margin="0,60,0,80">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="RightPanelTransform" X="300"/>
            </Grid.RenderTransform>

            <StackPanel Margin="20">
                <TextBlock x:Name="RightPanelTitle" Text="" Style="{StaticResource TimerTextStyle}" Margin="0,0,0,20"/>
                <ContentControl x:Name="RightPanelContent"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
