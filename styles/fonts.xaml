<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="GameFont">Consolas</FontFamily>

    <Style x:Key="GameTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GameFont}"/>
        <Setter Property="Foreground" Value="#E0E0E0"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="ResourceTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GameTextStyle}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TimerTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GameTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="GameButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#2A2A2A"/>
        <Setter Property="Foreground" Value="#E0E0E0"/>
        <Setter Property="BorderBrush" Value="#404040"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource GameFont}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

</ResourceDictionary>
